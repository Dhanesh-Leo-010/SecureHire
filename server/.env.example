# Copy to server/.env. In development, secrets are auto-generated into server/data/.dev-secrets.json if unset.
PORT=4000
NODE_ENV=development
# Comma-separated web origins allowed by CORS (and that set cookies)
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app (used in offer QR verification links)
PUBLIC_WEB_URL=http://localhost:5173

# Secrets — REQUIRED in production (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
AADHAAR_HMAC_KEY=
DATA_ENCRYPTION_KEY=
OFFER_SIGNING_KEY=

# Demo mode shows OTPs on screen and exposes synthetic test data hints. Set false for real use.
DEMO_MODE=true
# Express "trust proxy" — set to the number of proxy hops or a CIDR when behind a load balancer (e.g. 1 on Render)
TRUST_PROXY=loopback
# Approximate IP geolocation: ip-api | none
GEO_PROVIDER=ip-api
# Local Sentence-Transformers model (all-MiniLM-L6-v2). false = lexical fallback.
ENABLE_SEMANTIC_MODEL=true
# Optional: Claude API for narrative resume summaries (rules-based summary when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional storage locations
# DB_FILE=./data/securehire.db
# UPLOAD_DIR=./data/uploads
