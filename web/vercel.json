{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-URL/api/:path*" },
    { "source": "/((?!api/|models/|assets/|extension-test.html|favicon.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
  ]
}
